// ═══════════════════════════════════════════════════════════════
// Neovim and tmux macros, for the Nav layer
// Version: 0.1
// Date: 07/Oct/2026
// ═══════════════════════════════════════════════════════════════

// ── tmux: prefix C-a, then the key (dotfiles tmux/tmux.conf) ──
// C-a needs a macro: A is the left home-row Ctrl, so the chord cannot be typed

tm_prefix: tm_prefix {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <40>;
    bindings = <&kp LC(A)>;
    display-name = "tmux prefix";
};

tm_last_window: tm_last_window {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <40>;
    bindings = <&kp LC(A)>, <&kp TAB>;
    display-name = "tmux last window";
};

tm_last_session: tm_last_session {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <40>;
    bindings = <&kp LC(A)>, <&kp BSPC>;
    display-name = "tmux last session";
};

