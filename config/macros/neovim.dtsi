// ── Neovim single keys ──
// Cross-hand home-row Ctrl reaches these too (O+S, O+R, A+O, A+I);
// these are the one-key versions

nv_alt_file: nv_alt_file {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <40>;
    // Ctrl+6 is the terminal byte for C-^
    bindings = <&kp LC(N6)>;
    display-name = "C-^ alternate file";
};

nv_save: nv_save {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <40>;
    bindings = <&kp LC(S)>;
    display-name = "C-s save";
};

nv_redo: nv_redo {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <40>;
    bindings = <&kp LC(R)>;
    display-name = "C-r redo";
};

nv_jump_back: nv_jump_back {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <40>;
    bindings = <&kp LC(O)>;
    display-name = "C-o jump back";
};

nv_jump_fwd: nv_jump_fwd {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <40>;
    // Legacy terminals send C-i as Tab; jumps forward either way
    bindings = <&kp LC(I)>;
    display-name = "C-i jump forward";
};
