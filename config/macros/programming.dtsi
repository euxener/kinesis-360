    display-name = "/* */";
};

// Added with the six-layer plan. Plain keys, no dead keys:
// the pairs end with Left, so the cursor lands inside
pm_squotes: pm_squotes {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <40>;
    bindings = <&kp SQT>, <&kp SQT>, <&kp LEFT>;
    display-name = "''";
};

pm_dquotes: pm_dquotes {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <40>;
    bindings = <&kp DQT>, <&kp DQT>, <&kp LEFT>;
    display-name = "\"\"";
};

