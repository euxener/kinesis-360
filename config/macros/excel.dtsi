// Sequential Keypresses (Excel Ribbon Navigation)
mcb_expand_grp: mcb_expand_grp {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <50>;
    tap-ms = <50>;
    bindings = <&kp LALT>, <&kp A>, <&kp J>;
    display-name = "Expand Column/Row";
};

mcb_collapse_grp: mcb_collapse_grp {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <50>;
    tap-ms = <50>;
    bindings = <&kp LALT>, <&kp A>, <&kp H>;
    display-name = "Collapse Column/Row";
};

mcb_super_find: mcb_super_find {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <50>;
    tap-ms = <50>;
    bindings = <&kp LALT>, <&kp X>, <&kp N>;
    display-name = "Super Find";
};

mcb_insert_note: mcb_insert_note {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
