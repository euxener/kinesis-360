// Number Format Macros
mcb_num_cycle: mcb_num_cycle {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&kp LC(LS(N1))>;
    display-name = "Number Cycle";
};

mcb_pct_cycle: mcb_pct_cycle {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&kp LC(LS(N2))>;
    display-name = "Percent Cycle";
};

mcb_mult_cycle: mcb_mult_cycle {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&kp LC(LS(N3))>;
    display-name = "Multiple Cycle";
};

